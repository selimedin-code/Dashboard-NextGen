# Copy to .env and fill in. NEVER commit .env.
# On Render, set these as environment variables in the dashboard, not in the repo.

# --- Database ---
# Local dev (Homebrew Postgres, default superuser = your macOS username):
DATABASE_URL=postgresql+psycopg://localhost:5432/nextgen
# Render provides a postgres:// URL; the app rewrites it to postgresql+psycopg:// automatically.

# --- HTTP Basic Auth (guards the whole app) ---
BASIC_AUTH_USER=nextgen
BASIC_AUTH_PASS=change-me

# --- External data sources (Phase 4+; not needed for scaffold) ---
ALPHAVANTAGE_API_KEY=
FMP_API_KEY=
# Free key: https://fred.stlouisfed.org/docs/api/api_key.html (macro gauges on /risk)
FRED_API_KEY=

# --- App ---
# Comma-separated. "*" is fine for two internal users behind auth.
APP_ENV=development
